    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-riscv",
            "type": "shell",
            "command": "GOTO_DEBUG=1 /home/zekailin00/Desktop/riscv-gnu-toolchain/drops/linux/bin/qemu-riscv64 -cpu rv64,v=true,vlen=256,vext_spec=v1.0 -L /home/zekailin00/Desktop/chipyard-t/.conda-env/riscv-tools/sysroot -g 6969 ${workspaceFolder}/build-riscv/ov_msckf/run_illixr_msckf ${workspaceFolder}/data/mav0/cam0/data.csv ${workspaceFolder}/data/mav0/cam1/data.csv ${workspaceFolder}/data/mav0/imu0/data.csv ${workspaceFolder}/data/mav0/cam0/data ${workspaceFolder}/data/mav0/cam1/data",
            "dependsOn": "build-riscv",
        },
        {
            "label": "build-riscv",
            "type": "shell",
            "command": "cmake --build build-riscv/. --target run_illixr_msckf -- -j$(nproc)",
        },
        {
            "label": "configure-riscv",
            "type": "shell",
            "command": "cmake -S . -B build-riscv -DCMAKE_VERBOSE_MAKEFILE=ON -DCMAKE_TOOLCHAIN_FILE=../cmake/toolchain.cmake -DCMAKE_BUILD_TYPE=Debug",
        }
    ]
}